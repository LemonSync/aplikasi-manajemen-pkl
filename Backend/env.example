# ================================
# APPLICATION
# ================================
NODE_ENV=development
PORT=4000
APP_NAME="Sistem Manajemen PKL"
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
TIMEZONE=Asia/Jakarta

# ================================
# DATABASE (MySQL)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# ================================
DATABASE_URL="mysql://pkl_user:pkl_password@localhost:3306/pkl_db"

# ================================
# JWT / AUTH
# ================================
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long_ok!
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long_ok!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ================================
# FILE STORAGE (di luar webroot)
# ================================
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=10

# ================================
# RATE LIMIT
# ================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# ================================
# SEED (akun super-admin pertama)
# ================================
SEED_SUPERADMIN_USERNAME=superadmin

SEED_SUPERADMIN_PASSWORD="Admin12345!"
SEED_SUPERADMIN_NAME="Super Administrator"

# ================================
# CORS (pisahkan dengan koma)
# ================================
CORS_ORIGINS=http://localhost:5173
